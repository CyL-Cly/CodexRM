<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing tokens are encrypted with a device-bound Keystore key and must
     never leave this device, including device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>