[Unit]
Description=CodexRM dedicated NAT diagnostic STUN (STUNTMAN)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/stunserver --configfile /etc/codexrm/nat-stun.json
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
