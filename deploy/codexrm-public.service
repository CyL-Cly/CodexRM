[Unit]
Description=CodexRM public relay
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=codexrm-public
StateDirectoryMode=0700
WorkingDirectory=/opt/codexrm-public
ExecStart=/opt/codexrm-public/bin/codexrm-server --addr 127.0.0.1:18081 --data /var/lib/codexrm-public --web /opt/codexrm-public/web --public-enrollment --p2p-lan=false --web-trust-loopback-proxy
Environment=GOMEMLIMIT=160MiB
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=256M
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
