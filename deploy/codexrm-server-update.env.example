# The updater reads this file at each timer activation. No relay restart needed.
CODEXRM_SERVER_AUTO_UPDATE=true
# Standard five fields: minute hour day-of-month month day-of-week.
CODEXRM_SERVER_UPDATE_CRON="0 3 * * *"
CODEXRM_SERVER_UPDATE_TZ=Asia/Singapore
# Override the packaged HTTPS update source, if any. An empty value disables it.
# Source builds have no update source unless configured here.
# CODEXRM_SERVER_UPDATE_URL=https://updates.example.com/server-update.json
